SQL Joins
1.INNER JOIN 
---returns only matching records from both tables.
SELECT C.Customer_id,C.Customer_name,O.Order_idO.Order_name from Customers AS C INNER JOIN Ordrs As O on C.Customer_id=O.Customer_id;

2. LEFT JOIN
---return all records from left table and matching records from right table
SELECT C.Customer_id,C.Customer_name,O.Order_idO.Order_name from Customers AS C LEFT JOIN Ordrs As O on C.Customer_id=O.Customer_id;

3. RIGHT JOIN
---return all records from right table and matching records from left table
SELECT C.Customer_id,C.Customer_name,O.Order_idO.Order_name from Customers AS C RIGHT JOIN Ordrs As O on C.Customer_id=O.Customer_id;

4.  OUTER JOIN
----return all records from both tables
-----Matching records are combined.
SELECT C.Customer_id,C.Customer_name,O.Order_idO.Order_name from Customers AS C OUTER JOIN Ordrs As O on C.Customer_id=O.Customer_id;

5.  Finding Unmatched customers
----Customers who have not placed any order
SELECT c.customer_id,c.customer_name from customers AS c LEFT JOIN orders AS o on c.customer_id=o.customer_id where o.customer_id is NULL;

6.  Finding Unmatched Orders
-----orders that do not have matching customer.
SELECT o.order_id,o.customer_id,o.amount from orders as o LEFT JOIN customers as c on o.order_id=o.customer_id where c.customer_id is NULL;

7.  SELF JOIN
--EX: employees and their managers
--   the same table is joined with itself.
SELECT e.employee_id,e.employee_name AS employee,m.employee_name AS Manger from employees as e left join employees as m on e.employee_id=m.employee_id;

8.  JOIN with table aliases 
--Aliases make join queries easier to read.
SELECT c.customer_id,o.order_id,,o.amount from customers AS c join orders as o on c.customer_id=o.customer_id;

9.  Duplicate rows caused by JOINs
---if one customers has multiple orders
---that customer appears once for each matching order.
---count can be used to analyze the number of orders.
SELECT c.customer_id,c.customer_name,count(o.order_id) AS total orders from customers AS c left join orders As o on c.customer_id=o.customer_id Group by c.customer_id,c.customer_name;

















